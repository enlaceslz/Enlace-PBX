rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Auth Helpers
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // Validation Helpers
    function isValidId(id) { return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidTenant(data) {
      return data.keys().hasAll(['id', 'name', 'plan', 'status'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 256
        && data.plan in ['startup', 'business', 'enterprise']
        && data.status in ['active', 'suspended'];
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'tenantId', 'name', 'email', 'role', 'status'])
        && data.id is string && data.id.size() <= 128
        && data.tenantId is string && data.tenantId.size() <= 128
        && data.name is string && data.name.size() <= 256
        && data.email is string && data.email.size() <= 256
        && data.role in ['superadmin', 'admin', 'manager', 'agent']
        && data.status in ['active', 'inactive'];
    }

    match /tenants/{tenantId} {
      allow read: if isSignedIn(); // Simplified for MVP
      allow create: if isAdmin() && isValidId(tenantId) && isValidTenant(incoming()) && incoming().id == tenantId;
      allow update: if isAdmin() && isValidId(tenantId) && isValidTenant(incoming()) && incoming().id == existing().id;
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) && isValidUser(incoming()) && incoming().id == userId;
      allow update: if (isAdmin() || isOwner(userId)) && isValidId(userId) && isValidUser(incoming()) && incoming().id == existing().id;
      allow delete: if isAdmin();
    }
    
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable from backend
    }
  }
}
