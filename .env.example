# GEMINI_API_KEY: Chave de API oficial do Google Gemini (para agentes cognitivos MaIA)
GEMINI_API_KEY=

# APP_URL: URL canônica da aplicação em produção
APP_URL=

# JWT_SECRET: Chave mestra criptográfica (256 bits) para assinatura e verificação de tokens JWT
JWT_SECRET=

# DATABASE_URL: String de conexão PostgreSQL corporativa
# IMPORTANTE: Em produção, o uso do superusuário 'postgres' é expressamente proibido (fail-closed).
# Utilize o usuário restrito operacional 'enlace_app' com privilégios mínimos.
# Exemplo: postgresql://enlace_app:SUA_SENHA_FORTE@127.0.0.1:5432/enlace_pbx
DATABASE_URL=

# ENCRYPTION_KEY: Chave simétrica obrigatória para criptografia AES-256-GCM de segredos SIP
# Formato: 32 bytes (64 caracteres hexadecimais gerados via: openssl rand -hex 32) ou mínimo 32 caracteres
ENCRYPTION_KEY=

# ASTERISK_*: Parâmetros de conexão com o Asterisk 20 LTS (AMI - Asterisk Manager Interface)
ASTERISK_HOST=127.0.0.1
ASTERISK_AMI_HOST=127.0.0.1
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=enlace_ami
ASTERISK_AMI_USERNAME=enlace_ami
ASTERISK_AMI_PASSWORD=

# ASTERISK_ARI_*: Parâmetros de conexão com o Asterisk 20 LTS (ARI - Asterisk REST Interface)
ASTERISK_ARI_URL=http://127.0.0.1:8088
ASTERISK_ARI_USER=enlace_ari
ASTERISK_ARI_USERNAME=enlace_ari
ASTERISK_ARI_PASSWORD=

# Credenciais do Administrador Inicial (Bootstrap obrigatório no primeiro acesso)
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=

# WHATSAPP_*: Parâmetros para Webhook oficial Meta WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=


# Servidor e proxy reverso local
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
TRUSTED_PROXIES=loopback
CORS_ALLOWED_ORIGINS=https://pbx.suaempresa.com.br

# Versão habilitada no aplicativo Meta (consulte o painel da Meta)
WHATSAPP_GRAPH_API_VERSION=

# Gateway 9router: somente configuração do servidor
NINEROUTER_URL=
NINEROUTER_API_KEY=

# Migrações: DATABASE_MIGRATION_URL deve ser fornecida SOMENTE ao comando db:migrate.
# Não configure a credencial administrativa no serviço HTTP ou no PM2.

# Integrações HTTP: origens exatas aprovadas no servidor, sem caminhos.
OUTBOUND_ALLOWED_ORIGINS=
# Exceção explícita para integração interna (inclua também na lista acima).
# Nunca permite metadados link-local, multicast ou endereços reservados.
OUTBOUND_PRIVATE_ORIGINS=
NINEROUTER_MODEL=

# Vínculos administrativos para testes reais de ferramentas, por empresa e ID.
# Array JSON: tenantId, toolId, endpoint absoluto exato, method GET/POST e bearerToken opcional.
# Não cadastrar tokens no frontend, no schema ou na URL da ferramenta.
AI_TOOL_BINDINGS_JSON=[]

# Destinos de webhook: segredo HMAC somente no servidor (mínimo 32 caracteres).
# Array JSON: tenantId, webhookId, endpoint absoluto exato e signingSecret.
WEBHOOK_BINDINGS_JSON=[]

# Extração de entidades: autorização explícita por empresa e modelo obrigatório.
ENTITY_EXTRACTION_ENABLED_TENANTS=
ENTITY_EXTRACTION_MODEL=

# Supervisor assistido: autorização explícita para envio externo e gravação de trechos.
QUALITY_REVIEW_ENABLED_TENANTS=
QUALITY_REVIEW_MODEL=

# Copiloto: seleção de catálogo revisado, sem geração livre ou envio automático.
COPILOT_ENABLED_TENANTS=
COPILOT_MODEL=
