# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Chave mestra obrigatória para assinatura e verificação de tokens JWT.
# O servidor Enlace-PBX NÃO inicia se este valor não for fornecido.
JWT_SECRET=""

# DATABASE_URL: String de conexão com o banco de dados PostgreSQL oficial
DATABASE_URL="postgresql://postgres:senha@localhost:5432/enlace_pbx"

# ASTERISK_*: Parâmetros de conexão com o Asterisk 20 LTS (AMI e ARI)
ASTERISK_HOST="127.0.0.1"
ASTERISK_AMI_PORT="5038"
ASTERISK_AMI_USER="enlace_ami"
ASTERISK_AMI_PASSWORD="enlace_ami_secret"
ASTERISK_ARI_URL="http://127.0.0.1:8088"
ASTERISK_ARI_USER="enlace_ari"
ASTERISK_ARI_PASSWORD="enlace_ari_secret"
