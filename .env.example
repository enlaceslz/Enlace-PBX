# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# JWT_SECRET: Chave mestra obrigatória para assinatura e verificação de tokens JWT.
JWT_SECRET=

# DATABASE_URL: String de conexão com o banco de dados PostgreSQL oficial
DATABASE_URL=

# ASTERISK_*: Parâmetros de conexão com o Asterisk 20 LTS (AMI e ARI)
ASTERISK_HOST=127.0.0.1
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=
ASTERISK_AMI_PASSWORD=
ASTERISK_ARI_URL=http://127.0.0.1:8088
ASTERISK_ARI_USER=
ASTERISK_ARI_PASSWORD=

# Credenciais do Administrador Inicial (Bootstrap explícito)
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=

# ENCRYPTION_KEY: Chave simétrica obrigatória para criptografia AES-256-GCM (mínimo 32 caracteres)
ENCRYPTION_KEY=

# WHATSAPP_*: Parâmetros para Webhook oficial Meta WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
