# GEMINI_API_KEY: Chave de API oficial do Google Gemini (para agentes cognitivos MaIA)
GEMINI_API_KEY=

# APP_URL: URL canônica da aplicação em produção
APP_URL=

# JWT_SECRET: Chave mestra criptográfica (256 bits) para assinatura e verificação de tokens JWT
JWT_SECRET=

# DATABASE_URL: String de conexão PostgreSQL corporativa
# IMPORTANTE: Em produção, o uso do superusuário 'postgres' é expressamente proibido (fail-closed).
# Utilize o usuário restrito operacional 'enlace_app' com privilégios mínimos.
# Exemplo: postgresql://enlace_app:SUA_SENHA_FORTE@127.0.0.1:5432/enlace_pbx
DATABASE_URL=

# MIGRATION_DATABASE_URL: somente no processo administrativo npm run db:migrate.
# Não disponibilizar esta credencial ao servidor web ou ao frontend. Sem fallback para DATABASE_URL.
# As migrações históricas exigem superusuário no banco enlace_pbx.
MIGRATION_DATABASE_URL=

# ENCRYPTION_KEY: Chave simétrica obrigatória para criptografia AES-256-GCM de segredos SIP
# Formato: 32 bytes (64 caracteres hexadecimais gerados via: openssl rand -hex 32) ou mínimo 32 caracteres
ENCRYPTION_KEY=

# ASTERISK_*: Parâmetros de conexão com o Asterisk 20 LTS (AMI - Asterisk Manager Interface)
ASTERISK_HOST=127.0.0.1
ASTERISK_AMI_HOST=127.0.0.1
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=enlace_ami
ASTERISK_AMI_USERNAME=enlace_ami
ASTERISK_AMI_PASSWORD=

# ASTERISK_ARI_*: Parâmetros de conexão com o Asterisk 20 LTS (ARI - Asterisk REST Interface)
ASTERISK_ARI_URL=http://127.0.0.1:8088
ASTERISK_ARI_USER=enlace_ari
ASTERISK_ARI_USERNAME=enlace_ari
ASTERISK_ARI_PASSWORD=

# Credenciais do primeiro administrador: npm run db:bootstrap após db:migrate.
# Somente no processo administrativo; retirar do ambiente do servidor após uso.
# Senha: mínimo de 12 caracteres, máximo de 72 bytes; não usar prefixos previsíveis.
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=

# WHATSAPP_*: Parâmetros para Webhook oficial Meta WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

